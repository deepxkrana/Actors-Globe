# Database (PostgreSQL / Neon Serverless Postgres)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET="actorsglobe_dev_jwt_secret_key_change_in_production_123!"
JWT_EXPIRES_IN="7d"

# CORS / Allowed Frontend Origin
FRONTEND_URL="http://localhost:5173"

# Storage Driver (defaults to local disk storage in development)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"

# S3-compatible Cloud Storage (AWS S3 / Cloudflare R2 / MinIO) - Optional
# S3_BUCKET="actorsglobe-media"
# S3_REGION="us-east-1"
# S3_ENDPOINT="https://s3.amazonaws.com"
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Payment Gateway (Razorpay / Mock in Dev & Tests)
PAYMENT_KEY_ID="rzp_test_actorsglobe_key_id"
PAYMENT_GATEWAY_SECRET="actorsglobe_payment_gateway_secret_key_default"
PAYMENT_WEBHOOK_SECRET="actorsglobe_payment_webhook_secret_key_default"
